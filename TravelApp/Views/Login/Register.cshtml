@{
    ViewData["Title"] = "Register";
}
@model TravelApp.Models.User

<link rel="stylesheet" href="~/css/Auth.css" asp-append-version="true" />

<div class="auth-container">
    <div class="auth-box">

        <div class="auth-tabs">
            <a class="auth-tab" asp-controller="Login" asp-action="Login">Login</a>
            <a class="auth-tab active" asp-controller="Login" asp-action="Register">Register</a>
        </div>

        <div class="auth-body">
            <div class="auth-brand">
                <h2>Create account</h2>
                <p>Start exploring with QuestVoyage</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="auth-msg-error">@ViewBag.Error</div>
            }

            <form asp-controller="Login" asp-action="Register" method="post">
                <input name="Name" placeholder="Full name" required />
                <input name="Phone" placeholder="Contact number" required />
                <input type="email" name="Email" placeholder="Email address" required />
                <input type="password" name="Password" placeholder="Password" required />
                <input type="password" name="confirmPassword" placeholder="Confirm password" required />
                <button type="submit">Create account</button>
            </form>

            @if (ViewBag.Success != null)
            {
                <div class="auth-msg-success">@ViewBag.Success</div>
            }
        </div>

        <div class="auth-footer">
            <p>Already have an account? <a asp-controller="Login" asp-action="Login">Sign in</a></p>
        </div>

    </div>
</div>

<script src="~/js/auth.js"></script>