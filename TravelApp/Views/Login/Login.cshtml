@{
    ViewData["Title"] = "Login";
}
@model TravelApp.Models.User

<link rel="stylesheet" href="~/css/Auth.css" asp-append-version="true" />

<div class="auth-container">
    <div class="auth-box">

        <div class="auth-tabs">
            <a class="auth-tab active" asp-controller="Login" asp-action="Login">Login</a>
            <a class="auth-tab" asp-controller="Login" asp-action="Register">Register</a>
        </div>

        <div class="auth-body">
            <div class="auth-brand">
                <h2>Welcome back</h2>
                <p>Sign in to continue your journey</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="auth-msg-error">@ViewBag.Error</div>
            }

            <form asp-controller="Login" asp-action="Login" method="post" autocomplete="off">
                <input type="email" name="Email" placeholder="Email address" autocomplete="off" required />
                <input type="password" name="Password" placeholder="Password" autocomplete="new-password" required />
                <button type="submit">Sign in</button>
            </form>

            @if (ViewBag.Success != null)
            {
                <div class="auth-msg-success">@ViewBag.Success</div>
            }
        </div>

        <div class="auth-footer">
            <p>New here? <a asp-controller="Login" asp-action="Register">Create an account</a></p>
        </div>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/auth.js"></script>