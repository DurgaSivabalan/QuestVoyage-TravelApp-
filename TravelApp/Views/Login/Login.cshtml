@{
    ViewData["Title"] = "Login";
    
}
@model TravelApp.Models.User
@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}
<link rel="stylesheet" href="~/css/Auth.css" asp-append-version="true"/>

<div class="auth-container">
        <div class="auth-box">
           
            <h2>Login to QuestVoyage</h2>

            <div class="login">
            <form asp-controller="Login" asp-action="Login" method="post" autocomplete="off">

                <input type="email" name="Email" placeholder="Enter Email" autocomplete="off" required />

                <input type="password" name="Password" placeholder="Enter Password" autocomplete="new-password" required />

                <button type="submit">Login</button>

            </form>

            </div>

        @if (ViewBag.Success != null)
        {
            <p style="color:green">@ViewBag.Success</p>
        }

        @if (ViewBag.Error != null)
        {
            <p style="color:red">@ViewBag.Error</p>
        }


            <p class="switch-link">
                New user? <a asp-controller="Login" asp-action="Register">Register here</a>
            </p>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/auth.js"></script>
    <script src="jquery-effects.js"></script>

