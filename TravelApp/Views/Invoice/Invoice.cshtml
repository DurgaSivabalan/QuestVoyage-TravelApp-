@model TravelApp.Models.Booking
@{
    ViewData["Title"] = "Invoice";
}
<link rel="stylesheet" href="~/css/Invoice.css" />
<div class="invoice-box">

    <!-- HEADER -->
    <div class="header">
        <img src="~/images/logo.jpg" class="logo" />

        <div class="title">
            <h2>Travel Invoice</h2>
            <p>Date: @DateTime.Now.ToShortDateString()</p>
        </div>
    </div>

    <hr />

    <!-- CUSTOMER -->
    <h3>Customer Details</h3>
    <p><b>Name:</b> @Model.Name</p>
    <p><b>Email:</b> @Model.UserEmail</p>
    <p><b>Mobile:</b> @Model.Mobile</p>


    <!-- BOOKING -->
    <h3>Booking Details</h3>
    <p><b>Package:</b> @Model.PackageName</p>
    <p><b>Members:</b> @Model.Members</p>

    <!-- TRAVELLERS -->
    <h3>Traveller Details</h3>

    <table>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Gender</th>
        </tr>

        @foreach (var t in Model.Travellers)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.Age</td>
                <td>@t.Gender</td>
            </tr>
        }
    </table>

    <!-- TOTAL -->
    <div class="total">
        <b>Total Amount: ₹@Model.TotalAmount</b>
    </div>

    <br />

    <button onclick="window.print()" class="print-btn">🖨️ Download / Print</button>
    
</div>
<div style="text-align:center; margin-top:20px;">
    <a href="/Home/Index" class="home-btn">Go to Home</a>
</div>
<script src="~/js/invoice.js"></script>