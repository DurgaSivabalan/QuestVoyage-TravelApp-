    @inject TravelApp.Models.AppDbContext _context
    @{
        ViewData["Title"] = "Home";

        var user = ViewBag.User;
        var bookings = ViewBag.Bookings;
    }

    @{
        var email = Context.Session.GetString("User");

        int wishlistCount = 0;

        if (email != null)
        {
            wishlistCount = _context.Wishlists.Count(x => x.UserEmail == email);
        }
    }

    <link rel="stylesheet" href="~/css/Style.css"/>


    <aside class="sidebar" id="sidebar">
        <div class="close-btn" id="closeBtn">✕</div>

        <h3 class="text-center">Quick Links</h3>

       <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="/Flights/Flights">Top Bookings</a></li>
        <li><a href="/Testimonial/Testimonial">Testimonial</a></li>
    </ul>
   

        <section class="sidebar-box contact-box">
            <h4>📞 Contact Us</h4>
            <p><strong>Phone:</strong> +91 98765 43210</p>
            <p><strong>Email:</strong> support@questvoyage.com</p>
            <a asp-controller="Form" asp-action="Form" class="contact-link">Send Message</a>
        </section>
    </aside>

    <!-- OVERLAY -->
    <div class="overlay" id="overlay"></div>

    <!-- HEADER -->
    <header style="display:flex; flex-direction: column; gap: 20px">

        <section class="navi">

            <!-- LEFT -->
            <div class="nav-left">
                <img src="~/images/logo.jpg" class="logo-img" />
                <h2 class="logo-text">QuestVoyage</h2>
            </div>

            <!-- RIGHT -->
            <div class="nav-right">

            
                <!-- ICONS -->
                <div class="icon-btn">
                    <a asp-controller="Wishlist" asp-action="Wishlist">
                        <img src="~/images/wishlist icon.png" />
                        @if (wishlistCount > 0)
                        {
                            <span class="badge">@wishlistCount</span>
                        }
                    </a>
                </div>

                <div class="icon-btn">
                    <a asp-controller="Packages" asp-action="Index">
                        <img src="~/images/filter.png" />
                    </a>
                </div>

                <!-- PROFILE -->
                <div class="profile-wrapper">
                    <div class="nav-avatar" id="profileToggle">
                        @Context.Session.GetString("User")?.Substring(0,1).ToUpper()
                    </div>

                    <div class="profile-dropdown" id="profileBox">
                        <a asp-controller="Profile" asp-action="Profile" class="dropdown-item">
                            👤 @Context.Session.GetString("User")
                        </a>
                        <a asp-controller="Book" asp-action="History" class="dropdown-item">
                            📖 My Bookings
                        </a>
                        <form asp-controller="Login" asp-action="Logout" method="post">
                            <button class="dropdown-item logout-btn">Logout</button>
                        </form>
                    </div>
                </div>

                <!-- HAMBURGER -->
                <div class="hamburger" id="hamburger">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

            </div>

        </section>
    </header>

    <!-- CONTENT -->
    <section class="welcome">
        <section class="text-center">
            <h1>Welcome to "Dream Destination"</h1>
            <h3>
                "Travel far enough, you meet yourself,
                Let us plan the journey you'll never forget."
            </h3>

            <!-- REPLACE WITH -->
            <div style="display:flex; gap:16px; justify-content:center; margin-top:32px;">
                <a asp-controller="Book" asp-action="Book" class="hero-btn-primary">Book Trip</a>
                <a asp-controller="Packages" asp-action="Index" class="hero-btn-secondary">Explore More</a>
            </div>

        </section>
    </section>
    <!--Packages section-->
    <section class="packages-section">
      <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:36px;">
        <h2>Tour Packages</h2>
        <p style="max-width:340px; font-size:0.88rem; color:#64748b; text-align:right; margin:0;">
          Handpicked packages for every type of traveller — book your perfect trip today.
        </p>
      </div>

      <div class="packages-container" id="pkgGrid">

        <div class="package-item">
          <img src="~/images/family.webp" alt="Family Package" />
          <span class="pkg-pill">Family</span>
          <span class="pkg-price">From ₹12,999</span>
          <p>Kid-friendly stays, guided tours &amp; meals for everyone.</p>
        </div>

        <div class="package-item">
          <img src="~/images/friends.webp" alt="Friends Tour" />
          <span class="pkg-pill">Friends</span>
          <span class="pkg-price">From ₹8,499</span>
          <p>Group adventures, shared stays &amp; endless memories.</p>
        </div>

        <div class="package-item">
          <img src="~/images/couple.webp" alt="Couples Tour" />
          <span class="pkg-pill">Couples</span>
          <span class="pkg-price">From ₹9,999</span>
          <p>Romantic escapes with private dining &amp; scenic views.</p>
        </div>

        <div class="package-item">
          <img src="~/images/honeymoon.webp" alt="Honeymoon" />
          <span class="pkg-pill">Honeymoon</span>
          <span class="pkg-price">From ₹18,999</span>
          <p>Luxury resorts, candle-lit evenings &amp; beach sunsets.</p>
        </div>

        <div class="package-item">
          <img src="~/images/corporate.webp" alt="Office Outing" />
          <span class="pkg-pill">Corporate</span>
          <span class="pkg-price">From ₹6,499</span>
          <p>Team bonding trips with activities &amp; group discounts.</p>
        </div>

        <div class="package-item">
          <img src="~/images/combo1.webp" alt="Combo Offer" />
          <span class="pkg-pill">Combo</span>
          <span class="pkg-price">From ₹14,999</span>
          <p>Multi-destination bundles with flights, hotels &amp; tours.</p>
        </div>

        <div class="package-item">
          <img src="~/images/solo.webp" alt="Solo Travel" />
          <span class="pkg-pill">Solo</span>
          <span class="pkg-price">From ₹4,999</span>
