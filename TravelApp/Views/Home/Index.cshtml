        <section class="flex">
          <h3>Contact</h3>
          <p>📞 +91 98765 43210</p>
          <p>✉️ support@travelagency.com</p>
          <a href="https://maps.google.com"  style="text-decoration: none; color: black  ;">📍 View on Map</a>
        </section>
      </section>

      <p class="footer-bottom">© 2026 Travel Agency. All Rights Reserved.</p>
    </footer>

    

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/auth.js"></script>
