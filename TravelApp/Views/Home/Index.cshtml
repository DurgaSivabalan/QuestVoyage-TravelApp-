        </div>

      </div>

      <div class="packages-footer">
        <button class="btn-pkg-more"
          onclick="document.getElementById('pkgGrid').classList.toggle('expanded');
                   this.textContent = this.textContent.includes('more') ? 'View less' : 'View more';">
          View more
        </button>
      </div>
    </section>

        <!-- WHY CHOOSE US -->
