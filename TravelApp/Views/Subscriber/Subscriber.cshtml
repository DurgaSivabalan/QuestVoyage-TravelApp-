@model IEnumerable<TravelApp.Models.Subscriber>

<h2>Subscribers</h2>

<table style="width:100%; border-collapse: collapse;">
    <tr style="background:#2c3e50; color:white;">
        <th>Name</th>
        <th>Email</th>
        <th>Date</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.SubscribedOn.ToString("dd MMM yyyy")</td>
        </tr>
    }
</table>
<script src="~/js/script.js"></script>